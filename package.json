{
  "name": "trance-studio",
  "productName": "Trance Studio",
  "version": "1.0.0",
  "private": true,
  "description": "Create hypnotic visual sessions and export them as videos",
  "author": "Trance Studio contributors",
  "homepage": "https://github.com/Ashyy0205/TranceStudio",
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && node scripts/dev.mjs --prod",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "render": "node scripts/dev.mjs --prod",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@fontsource/anton": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "immer": "10.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "zustand": "5.0.16"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.25.12": true,
    "electron@45.2.3": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "com.trancestudio.app",
    "productName": "Trance Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "fileAssociations": [
      {
        "ext": "trance",
        "name": "Trance session",
        "description": "Trance Studio session",
        "mimeType": "application/x-trance-session",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Trance-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Trance-Studio-${version}-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video",
      "executableName": "trance-studio",
      "maintainer": "Trance Studio contributors",
      "synopsis": "Create hypnotic visual sessions and export them as videos",
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "Trance-Studio-${version}.${ext}"
    },
    "deb": {
      "artifactName": "trance-studio_${version}_${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ]
  }
}
